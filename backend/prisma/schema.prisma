// schema.prisma - Definisi struktur database untuk Prisma ORM
// Prisma menggunakan file ini untuk membuat client dan tabel di PostgreSQL.

generator client {
  provider      = "prisma-client-js"
  // native = lokal, rhel-openssl-3.0.x = runtime Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Model-model di bawah ini dipetakan (@@map) persis ke tabel yang sudah ada
// di Supabase (casing huruf besarnya dipertahankan). Nama kolom API mengikuti
// nama kolom fisik di database (camelCase). Jangan ubah ke huruf kecil karena
// tabel fisiknya bernama `Profile`, `Experience`, dan `Project`.

model Profile {
  id        String   @id @default(uuid())
  name      String
  tagline   String
  bio       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Profile")
}

model Experience {
  id          String   @id @default(uuid())
  period      String
  roleTitle   String
  company     String
  description String
  skills      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Experience")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  projectUrl  String?
  techStack   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Project")
}