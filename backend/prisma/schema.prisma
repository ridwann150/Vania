// schema.prisma - Definisi struktur database untuk Prisma ORM
// Prisma menggunakan file ini untuk membuat client dan tabel di PostgreSQL.

generator client {
  provider      = "prisma-client-js"
  // native = lokal, rhel-openssl-3.0.x = runtime Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  link        String   @default("")
  images      String[] @default([])
  createdAt   DateTime @default(now())
}

model Experience {
  id           String   @id @default(uuid()) @db.Uuid
  type         String   @default("work") @db.VarChar(20)
  role_title   String
  organization String
  period       String   @default("")
  start_date   String   @default("")
  end_date     String   @default("")
  description  String   @default("")
  technologies String[] @default([])
  is_current   Boolean  @default(false)
  tags         String[] @default([])
  createdAt    DateTime @default(now())
}
