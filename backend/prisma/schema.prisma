// schema.prisma - Definisi struktur database untuk Prisma ORM
// Prisma menggunakan file ini untuk membuat client dan tabel di PostgreSQL.

generator client {
  provider      = "prisma-client-js"
  // native = lokal, rhel-openssl-3.0.x = runtime Vercel serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Model Prisma persis dengan nama tabel di Supabase (`Profile`, `Experience`,
// `Project`), jadi tanpa perlu @@map. Nama kolom mengikuti nama kolom fisik
// di database (camelCase).

model Profile {
  id        String   @id @default(uuid())
  name      String
  tagline   String
  bio       String
  about     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(uuid())
  period      String
  roleTitle   String
  company     String
  description String
  skills      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  projectUrl  String?
  techStack   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}